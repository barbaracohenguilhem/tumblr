{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    padding: {{ block.settings.padding }}px;
    box-sizing: border-box;
  }

  .ai-editorial-{{ ai_gen_id }}__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(260px, 0.8fr);
    align-items: center;
    gap: clamp(24px, 5vw, 76px);
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-editorial-{{ ai_gen_id }}__media {
    overflow: hidden;
    background: #eee;
    aspect-ratio: 4 / 3;
  }

  .ai-editorial-{{ ai_gen_id }}__media img,
  .ai-editorial-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-{{ ai_gen_id }}__copy {
    max-width: 470px;
  }

  .ai-editorial-{{ ai_gen_id }}__eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .ai-editorial-{{ ai_gen_id }}__eyebrow::before {
    content: '';
    width: 28px;
    height: 1px;
    background: currentColor;
  }

  .ai-editorial-{{ ai_gen_id }}__title {
    margin: 0 0 20px;
    color: inherit;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(34px, 5vw, {{ block.settings.heading_size }}px);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1.03;
  }

  .ai-editorial-{{ ai_gen_id }}__description {
    margin: 0 0 26px;
    font-size: 16px;
    line-height: 1.7;
  }

  .ai-editorial-{{ ai_gen_id }}__description p {
    margin: 0 0 12px;
  }

  .ai-editorial-{{ ai_gen_id }}__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 6px;
    color: inherit;
    border-bottom: 1px solid currentColor;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .ai-editorial-{{ ai_gen_id }}__link:hover {
    color: {{ block.settings.accent_color }};
  }

  .ai-editorial-{{ ai_gen_id }}__link:focus-visible {
    outline: 2px solid {{ block.settings.accent_color }};
    outline-offset: 4px;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding }}px;
    }

    .ai-editorial-{{ ai_gen_id }}__inner {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .ai-editorial-{{ ai_gen_id }}__media {
      aspect-ratio: 5 / 4;
    }

    .ai-editorial-{{ ai_gen_id }}__copy {
      max-width: none;
    }
  }
{% endstyle %}

<div class="ai-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-{{ ai_gen_id }}__inner">
    <div class="ai-editorial-{{ ai_gen_id }}__media">
      {% if block.settings.image != blank %}
        <img
          src="{{ block.settings.image | image_url: width: 1600 }}"
          alt="{{ block.settings.image.alt | default: block.settings.headline | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
        >
      {% else %}
        <div class="ai-editorial-{{ ai_gen_id }}__placeholder">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
    <div class="ai-editorial-{{ ai_gen_id }}__copy">
      {% if block.settings.eyebrow != blank %}
        <p class="ai-editorial-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if block.settings.headline != blank %}
        <h2 class="ai-editorial-{{ ai_gen_id }}__title">{{ block.settings.headline | escape }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <div class="ai-editorial-{{ ai_gen_id }}__description">{{ block.settings.description }}</div>
      {% endif %}
      {% if block.settings.link_label != blank and block.settings.story_link != blank %}
        <a class="ai-editorial-{{ ai_gen_id }}__link" href="{{ block.settings.story_link }}">
          {{ block.settings.link_label | escape }} <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial feature",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Feature image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Section label",
      "default": "The journal"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Stories worth slowing down for"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Introduction",
      "default": "<p>Thoughtful perspectives, considered details, and inspiration for living beautifully.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Read the story"
    },
    {
      "type": "url",
      "id": "story_link",
      "label": "Story link"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F4F1EB"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#25241F"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#6B3D2E"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Headline size",
      "min": 36,
      "max": 72,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Desktop spacing",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding",
      "label": "Mobile spacing",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Editorial feature"
    }
  ],
  "tag": null,
  "class": "editorial-feature-block"
}
{% endschema %}